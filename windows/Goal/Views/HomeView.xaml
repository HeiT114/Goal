<UserControl x:Class="Goal.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="38,8,38,104">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="HOME  ·  主页" Style="{StaticResource OverlineText}"/>
                    <TextBlock x:Name="GreetingText" Text="早上好，朋友" Style="{StaticResource DisplayText}" Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubGreetingText" Text="把目标做小一点，今天只向前一步。" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="13,9" VerticalAlignment="Top" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DateText" Text="11月1日 · 星期六" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Stats -->
            <Grid Grid.Row="1" Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource FlatCardStyle}" Margin="0,0,10,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="进行中" Style="{StaticResource SmallMutedText}"/>
                        <TextBlock x:Name="ActiveStat" Text="0" Style="{StaticResource NumberText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource FlatCardStyle}" Margin="5,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="已完成" Style="{StaticResource SmallMutedText}"/>
                        <TextBlock x:Name="DoneStat" Text="0" Style="{StaticResource NumberText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource FlatCardStyle}" Margin="10,0,0,0" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="完成率" Style="{StaticResource SmallMutedText}"/>
                            <TextBlock x:Name="PercentStat" Text="0%" Style="{StaticResource NumberText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="3"/>
                            <Ellipse x:Name="PercentRing" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" StrokeDashArray="1 3"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Filters -->
            <Grid Grid.Row="2" Margin="0,22,0,12">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource FilterChip}" GroupName="TaskFilter" Tag="all"
                                 Content="全部" IsChecked="True" Checked="Filter_Checked" Margin="0,0,7,0"/>
                    <RadioButton x:Name="FilterActive" Style="{StaticResource FilterChip}" GroupName="TaskFilter" Tag="active"
                                 Content="进行中" Checked="Filter_Checked" Margin="0,0,7,0"/>
                    <RadioButton x:Name="FilterDone" Style="{StaticResource FilterChip}" GroupName="TaskFilter" Tag="done"
                                 Content="已完成" Checked="Filter_Checked"/>
                </StackPanel>
                <TextBlock x:Name="ListHint" Style="{StaticResource SmallMutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel x:Name="TaskStack" Grid.Row="3"/>

            <Border x:Name="EmptyState" Grid.Row="4" Style="{StaticResource FlatCardStyle}" Padding="30,38" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="62" Height="62" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource AccentUltraSoftBrush}"/>
                        <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="EmptyTitle" Text="这里还很安静" Style="{StaticResource H2Text}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock x:Name="EmptyBody" Text="新建一个计划，从一个很小、但可以开始的步骤出发。" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                    <Button Style="{StaticResource SoftButton}" Content="新建第一个计划" HorizontalAlignment="Center" Margin="0,16,0,0" Click="AddButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
        <Button x:Name="AddButton" Style="{StaticResource AddPlanButton}" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,36,30" Click="AddButton_Click" ToolTip="新建计划"/>
    </Grid>
</UserControl>
