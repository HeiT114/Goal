<UserControl x:Class="Goal.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ThemeTile" TargetType="RadioButton">
            <Setter Property="Height" Value="76"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tile" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Tile" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentUltraSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="38,8,38,42" MaxWidth="1040" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="设置" Style="{StaticResource OverlineText}"/>
                <TextBlock Text="设置，让 goal 更像你" Style="{StaticResource DisplayText}" Margin="0,7,0,0"/>
                <TextBlock Text="只保存在这台电脑，没有账号。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
            </StackPanel>

            <!-- Profile -->
            <Border Grid.Row="1" Style="{StaticResource FlatCardStyle}" Padding="22,20" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock x:Name="AvatarText" Text="朋" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentDeepBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,2,0,0">
                                <TextBlock Text="个人资料" Style="{StaticResource H2Text}"/>
                                <TextBlock Text="只保存在本机。" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="SaveProfileButton" Style="{StaticResource SoftButton}" Content="保存资料"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="SaveProfile_Click"/>
                    </Grid>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="称呼" Style="{StaticResource SmallMutedText}" Margin="2,0,0,6"/>
                            <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" MaxLength="24"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="一句给自己的话" Style="{StaticResource SmallMutedText}" Margin="2,0,0,6"/>
                            <TextBox x:Name="MottoBox" Style="{StaticResource InputBox}" MaxLength="48"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ProfileHint" Style="{StaticResource SmallMutedText}" Margin="2,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Grid.Row="2" Style="{StaticResource FlatCardStyle}" Padding="22,20" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="外观" Style="{StaticResource H2Text}"/>
                            <TextBlock Text="选一套配色，或自定义。" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="深色模式" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ToggleButton x:Name="DarkToggle" Style="{StaticResource SwitchToggle}"
                                          Checked="DarkToggle_Changed" Unchecked="DarkToggle_Changed"/>
                        </StackPanel>
                    </Grid>
                    <UniformGrid x:Name="ThemePanel" Columns="3" Margin="0,18,0,2"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AccentPreview" Grid.Column="0" Width="38" Height="38" CornerRadius="11"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="自定义强调色" Style="{StaticResource SmallMutedText}"/>
                            <TextBlock Text="HEX，例如 #D9653B" Style="{StaticResource SmallMutedText}" Margin="0,2,0,0" Opacity="0.8"/>
                        </StackPanel>
                        <TextBox x:Name="AccentBox" Grid.Column="2" Style="{StaticResource InputBox}" Width="128" Margin="20,0,0,0"
                                 MaxLength="7" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="应用颜色" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="ApplyAccent_Click"/>
                        <TextBlock x:Name="AccentHint" Grid.Column="4" Style="{StaticResource SmallMutedText}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Grid.Row="3" Style="{StaticResource FlatCardStyle}" Padding="22,20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="数据" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="可读 JSON；插件文件不导出。" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="16,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="导出备份" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="单个 JSON 文件。" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" Content="导出" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Click="Export_Click"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="16,14">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="导入备份" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="校验后覆盖或合并。" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" Content="导入" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Click="Import_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="DataPathText" Style="{StaticResource SmallMutedText}" Margin="2,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Update -->
            <Border Grid.Row="4" Style="{StaticResource FlatCardStyle}" Padding="22,20" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="更新" Style="{StaticResource H2Text}"/>
                            <TextBlock Text="仅检查更新时联网。" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource GhostButton}" Content="检查更新"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="CheckUpdate_Click"/>
                    </Grid>
                    <TextBlock Text="GitHub 公益加速前缀" Style="{StaticResource SmallMutedText}" Margin="2,18,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PrefixBox" Style="{StaticResource InputBox}" MaxLength="240"/>
                        <Button Grid.Column="1" Style="{StaticResource SoftButton}" Content="保存" Margin="8,0,0,0" Click="SavePrefix_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="恢复默认" Margin="4,0,0,0" Click="ResetPrefix_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource SmallMutedText}" Margin="2,7,0,0" TextWrapping="Wrap"
                               Text="默认 https://ghproxy.net/。"/>
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SmallMutedText}" Margin="2,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Grid.Row="5" Style="{StaticResource FlatCardStyle}" Padding="22,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="goal" Style="{StaticResource H2Text}" FontSize="20"/>
                            <Border Background="{DynamicResource AccentUltraSoftBrush}" CornerRadius="6" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadgeText" Text="1.0.0" FontSize="10.5" Foreground="{DynamicResource AccentDeepBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="免费 · 无广告 · 无账号 · 无云同步" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                        <TextBlock Text=".NET 10 · 数据保存在本机" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="GOAL" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource LineBrush}"
                               VerticalAlignment="Bottom" Margin="20,0,2,0"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
