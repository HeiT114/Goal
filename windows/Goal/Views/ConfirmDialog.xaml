<UserControl x:Class="Goal.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440" Focusable="True">
    <Border Style="{StaticResource CardStyle}" Padding="26,24,26,22" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="12" Direction="270" Opacity="0.20" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="确认" Style="{StaticResource H1Text}"/>
                    <Border x:Name="AccentRule" Width="30" Height="3" Background="{DynamicResource AccentBrush}" CornerRadius="2"
                            HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource RoundIconButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Cancel_Click">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                </Button>
            </Grid>
            <TextBlock x:Name="BodyText" Grid.Row="1" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,18,0,0"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Content="确认" Click="Primary_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
