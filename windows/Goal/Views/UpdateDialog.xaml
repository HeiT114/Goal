<UserControl x:Class="Goal.Views.UpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="600">
    <Border Style="{StaticResource CardStyle}" Padding="24,22" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="13" Direction="270" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="发现新版本" Style="{StaticResource H1Text}"/>
                    <TextBlock Text="更新只会从你设置的 GitHub 加速前缀检查和下载。" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource RoundIconButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="16,13" Margin="0,17,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前版本" Style="{StaticResource SmallMutedText}"/>
                        <TextBlock x:Name="CurrentVersionText" Text="1.0.0" Style="{StaticResource H2Text}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Bottom" Margin="16,0,16,5"/>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="最新版本" Style="{StaticResource SmallMutedText}"/>
                        <TextBlock x:Name="LatestVersionText" Text="" Style="{StaticResource H2Text}" Foreground="{DynamicResource AccentDeepBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="更新说明" Style="{StaticResource SmallMutedText}" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="13,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                        <TextBlock x:Name="NotesText" Text="" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource InkBrush}" LineHeight="20"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <ProgressBar x:Name="DownloadProgress" Style="{StaticResource SlimProgress}" Visibility="Collapsed" Margin="0,0,0,8"/>
                <TextBlock x:Name="StatusText" Text="" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <TextBlock Text="下载到系统下载文件夹，不会静默安装。" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RevealButton" Style="{StaticResource GhostButton}" Content="打开所在文件夹"
                            Visibility="Collapsed" Margin="0,0,8,0" Click="Reveal_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="稍后" Margin="0,0,8,0" Click="Close_Click"/>
                    <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}" Content="下载更新" Click="Download_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
