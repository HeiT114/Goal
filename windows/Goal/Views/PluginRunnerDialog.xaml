<UserControl x:Class="Goal.Views.PluginRunnerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="640" MaxHeight="720">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="14" Direction="270" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="17,17,0,0" Background="{DynamicResource AccentUltraSoftBrush}" Padding="24,20,22,18">
                <StackPanel>
                    <Border x:Name="AccentStripe" Height="3" Width="36" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <Grid>
                        <StackPanel Margin="0,0,36,0">
                            <TextBlock x:Name="TitleText" Text="插件面板" Style="{StaticResource H1Text}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SubtitleText" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="MetaText" Text="" Style="{StaticResource SmallMutedText}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource RoundIconButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                <StackPanel x:Name="BlocksHost" Margin="24,18,24,18"/>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,13">
                <StackPanel>
                    <TextBlock Text="插件由第三方作者独立发布，与《goal》原作者无关；用户添加插件后，应自行判断插件内容及浏览信息是否合规，原作者不承担由此产生的任何责任。"
                               TextWrapping="Wrap" FontSize="10.5" LineHeight="17" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="NoticeText" Text="" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
