<UserControl x:Class="Goal.Views.PluginInstallDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="580">
    <Border Style="{StaticResource CardStyle}" Padding="24,22" Background="{DynamicResource SurfaceBrush}" MaxHeight="720">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="13" Direction="270" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="安装插件" Style="{StaticResource H1Text}"/>
                    <TextBlock Text="先看清楚它是什么，再决定要不要。安装后默认关闭。" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource RoundIconButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" CornerRadius="13" Padding="16,14" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock x:Name="InitialText" Text="P" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentDeepBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PluginNameText" Text="插件" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock x:Name="PluginMetaText" Text="" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="入口文件" Style="{StaticResource SmallMutedText}"/>
                    <TextBlock x:Name="EntryText" Text="" Style="{StaticResource BodyText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="网络权限" Style="{StaticResource SmallMutedText}"/>
                    <TextBlock x:Name="NetworkText" Text="" Style="{StaticResource BodyText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="插件说明" Style="{StaticResource SmallMutedText}" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="13,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="90">
                        <TextBlock x:Name="DescriptionText" Text="" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}" LineHeight="19"/>
                    </ScrollViewer>
                </Border>
                <Border Background="{DynamicResource AccentUltraSoftBrush}" BorderBrush="{DynamicResource AccentSoftBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="责任声明" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentDeepBrush}"/>
                        <TextBlock Text="插件由第三方作者独立发布，与《goal》原作者无关；用户添加插件后，应自行判断插件内容及浏览信息是否合规，原作者不承担由此产生的任何责任。"
                                   TextWrapping="Wrap" FontSize="11.5" LineHeight="19" Margin="0,4,0,0" Foreground="{DynamicResource InkBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <StackPanel>
                    <CheckBox x:Name="ReadCheck" Content="我已阅读并理解上述责任声明" Checked="ReadCheck_Changed" Unchecked="ReadCheck_Changed"/>
                    <TextBlock Text="安装后不会自动启用；启用时会再次确认网络权限。" Style="{StaticResource SmallMutedText}" Margin="27,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="安装（默认关闭）" IsEnabled="False" Click="Install_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
