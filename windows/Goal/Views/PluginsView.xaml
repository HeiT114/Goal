<UserControl x:Class="Goal.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="38,8,38,42" MaxWidth="1040" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="插件" Style="{StaticResource OverlineText}"/>
                    <TextBlock Text="给 goal 加一点自己的东西" Style="{StaticResource DisplayText}" Margin="0,7,0,0"/>
                    <TextBlock Text="默认关闭，启用由你决定。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                    <Button Style="{StaticResource GhostButton}" Content="打开插件目录" Margin="0,0,8,0" Click="OpenFolder_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="添加插件" Click="AddPlugin_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="已安装" Style="{StaticResource H2Text}"/>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="7" Padding="8,2" Margin="9,1,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PluginCountText" Text="0 个" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="默认关闭" Style="{StaticResource SmallMutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="2">
                <StackPanel x:Name="PluginStack"/>
                <Border x:Name="EmptyState" Style="{StaticResource FlatCardStyle}" Padding="28,34" Margin="0,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource Surface2Brush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}" FontSize="21"
                                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="还没有添加插件" Style="{StaticResource H2Text}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="从 GitHub 等渠道获取，goal 不设插件市场。"
                                   Style="{StaticResource SmallMutedText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <Button Style="{StaticResource SoftButton}" Content="选择 .zip 插件包" HorizontalAlignment="Center"
                                Margin="0,15,0,0" Click="AddPlugin_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="3" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="2,18,0,0" Opacity="0.72"
                       Text="插件由第三方作者独立发布，与《goal》原作者无关；用户添加插件后，应自行判断插件内容及浏览信息是否合规，原作者不承担由此产生的任何责任。"/>
        </Grid>
    </ScrollViewer>
</UserControl>
