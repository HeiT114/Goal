<UserControl x:Class="Goal.Views.ImportChoiceDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520">
    <Border Style="{StaticResource CardStyle}" Padding="26,24,26,22" Background="{DynamicResource SurfaceBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="38" ShadowDepth="12" Direction="270" Opacity="0.20" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="导入数据" Style="{StaticResource H1Text}"/>
                    <Border Width="30" Height="3" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource RoundIconButton}" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                </Button>
            </Grid>
            <TextBlock x:Name="FileText" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
            <Border Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="10,7" Margin="0,12,0,0" HorizontalAlignment="Left">
                <TextBlock x:Name="ValidText" Text="格式校验通过" FontSize="11.5" Foreground="White"/>
            </Border>
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="16,13" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="ProfileText" Style="{StaticResource BodyText}"/>
                    <TextBlock x:Name="TaskText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ThemeText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="「覆盖导入」会用文件中的用户、主题与任务替换当前数据；「合并到现有」只追加文件中尚不存在的任务，保留当前用户与设置。插件文件不会随数据导入。"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource TextButton}" Content="取消" Margin="0,0,12,0" Click="Cancel_Click"/>
                <Button Style="{StaticResource GhostButton}" Content="合并到现有" Margin="0,0,8,0" Click="Merge_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="覆盖导入" Click="Overwrite_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
