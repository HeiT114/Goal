<Window x:Class="Goal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="goal" Width="1180" Height="800" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgGradientBrush}" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ProfileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,26,0,0">
                    <Grid Width="38" Height="38">
                        <Border CornerRadius="12" Background="{DynamicResource AccentGradientBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                                  Opacity="0.20" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                        <Ellipse Width="17" Height="17" Stroke="{DynamicResource OnAccentBrush}"
                                 StrokeThickness="2.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource OnAccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="goal" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" FontFamily="{StaticResource UiFont}"/>
                        <TextBlock Text="把目标，做小一点" FontSize="9.5" Margin="1,1,0,0"
                                   Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource UiFont}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="空间" Style="{StaticResource OverlineText}" Margin="14,0,0,8"/>
                    <RadioButton x:Name="HomeNav" GroupName="MainNav" Style="{StaticResource NavButton}"
                                 Tag="home" Checked="Nav_Checked" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Grid.Column="1" Text="主页" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="PluginsNav" GroupName="MainNav" Style="{StaticResource NavButton}"
                                 Tag="plugins" Checked="Nav_Checked" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Grid.Column="1" Text="插件" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav" GroupName="MainNav" Style="{StaticResource NavButton}"
                                 Tag="settings" Checked="Nav_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Grid.Column="1" Text="设置" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="3" Background="{DynamicResource AccentUltraSoftBrush}"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1"
                        CornerRadius="16" Padding="15,14" Margin="2,0,2,14">
                    <StackPanel>
                        <TextBlock Text="完成进度" Style="{StaticResource SmallMutedText}"/>
                        <Grid Margin="0,7,0,0">
                            <TextBlock x:Name="SidebarPercent" Text="0%" Style="{StaticResource NumberText}"
                                       FontSize="27"/>
                            <TextBlock x:Name="SidebarFraction" Text="0 / 0" FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" Margin="0,0,1,4"
                                       FontFamily="{StaticResource UiFont}"/>
                        </Grid>
                        <ProgressBar x:Name="SidebarProgress" Style="{StaticResource SlimProgress}"
                                     Value="0" Margin="0,8,0,0" Height="5"/>
                        <TextBlock x:Name="SidebarSummary" Text="还没有计划" FontSize="10.5" Margin="0,9,0,0"
                                   Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource UiFont}"/>
                    </StackPanel>
                </Border>

                <Button Grid.Row="4" x:Name="ProfileButton" Style="{StaticResource ProfileButtonStyle}"
                        Click="Profile_Click" Margin="0,0,0,18" ToolTip="个人资料与设置">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="34" Height="34">
                            <Border CornerRadius="11" Background="{DynamicResource AccentSoftBrush}"/>
                            <TextBlock x:Name="SidebarUserInitial" Text="朋" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentDeepBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource UiFont}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarUserName" Text="朋友" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource UiFont}"/>
                            <TextBlock Text="个人资料与设置" FontSize="9.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}"
                                   FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="CaptionText" Text="主页" FontSize="11" Margin="20,0,0,0"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFont}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Border Background="{DynamicResource AccentUltraSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="9,4" Margin="0,0,10,0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                       Foreground="{DynamicResource AccentDeepBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="本地离线" FontSize="9.5" Margin="5,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource UiFont}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="最大化" Margin="2,0"/>
                    <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ClipToBounds="True">
                <Border Background="{DynamicResource AmbientGlowBrush}" Width="640" Height="540"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-150,0"
                        IsHitTestVisible="False"/>
                <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Grid>
        </Grid>

        <!-- Overlay and dialogs -->
        <Grid x:Name="OverlayHost" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed">
            <Border x:Name="ScrimLayer" Background="{DynamicResource ScrimBrush}" Opacity="0"/>
            <ContentControl x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="28" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <ContentControl.RenderTransform>
                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Toast -->
        <Border x:Name="ToastRoot" Grid.ColumnSpan="2" Panel.ZIndex="30" Visibility="Collapsed"
                Background="{DynamicResource InkBrush}" CornerRadius="13" Padding="15,11"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                MaxWidth="560" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.28" Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="8"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Grid Width="23" Height="23" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource AccentBrush}" Opacity="0.22"/>
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                               Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="10,0,2,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ToastText" Text="就绪" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource OnAccentBrush}" TextWrapping="Wrap"
                               FontFamily="{StaticResource UiFont}"/>
                    <TextBlock x:Name="ToastDetail" Text="" FontSize="10.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource BgBrush}" Opacity="0.74" TextWrapping="Wrap"
                               Visibility="Collapsed" FontFamily="{StaticResource UiFont}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>